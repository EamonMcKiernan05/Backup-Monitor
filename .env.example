# Backup Monitor - Environment Configuration
# Copy to .env and fill in real values
# Credentials are stored in Vaultwarden - do NOT commit real values

# Proxmox nodes (comma-separated)
PROXMOX_NODES=192.168.1.7,192.168.1.8,192.168.1.9
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=<proxmox_root_password>
PROXMOX_PORT=8006

# TrueNAS servers
TRUENAS_MAIN_HOST=192.168.1.12
TRUENAS_MAIN_USER=<username>
TRUENAS_MAIN_PASSWORD=<password>
TRUENAS_BACKUP_HOST=192.168.1.108
TRUENAS_BACKUP_USER=<username>
TRUENAS_BACKUP_PASSWORD=<password>

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
REFRESH_INTERVAL=60
